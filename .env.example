# ========================================================================
# Muhammad Akram Portfolio & Visual Admin Studio
# Environment Configuration Template (.env.example)
# ========================================================================
# For local development or Render production deployment:
# Copy this file to .env and fill in your actual values.
# NEVER commit real secret keys or password values to Git!

# ========================================================================
# 1. SUPABASE POSTGRESQL & STORAGE CONFIGURATION
# ========================================================================
# Obtained from your Supabase Project Settings -> API:
# https://app.supabase.com/project/_/settings/api

# Your project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Public / Anon Key (Safe for client browsers)
SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-or-publishable-key"

# Supabase Secret / Service Role Key (SERVER-ONLY - NEVER EXPOSE TO BROWSER)
SUPABASE_SECRET_KEY="your-supabase-service-role-secret-key"

# ========================================================================
# 2. VISUAL ADMIN STUDIO AUTHENTICATION
# ========================================================================
# Master administrator email to access the Visual Studio (/studio)
STUDIO_ADMIN_EMAIL="admin@muhammadakram.dev"

# Master administrator passkey (minimum 12 characters recommended)
STUDIO_ADMIN_PASSWORD="REPLACE_WITH_YOUR_STRONG_STUDIO_PASSKEY"

# Optional session cryptographic secret for signing cookies/tokens
SESSION_SECRET="REPLACE_WITH_A_RANDOM_64_CHAR_HEX_SECRET"

# ========================================================================
# 3. RENDER / NODE.JS PRODUCTION RUNTIME
# ========================================================================
# Environment Mode ('development' or 'production')
NODE_ENV="production"

# Port assigned dynamically by Render (defaults to 3000 locally)
PORT=3000

# Allowed CORS origins in production (comma-separated if multiple)
# Example: https://muhammadakram.dev,https://akram-portfolio.onrender.com
ALLOWED_ORIGINS="https://muhammadakram.dev"

# Public URL of the app
APP_URL="https://muhammadakram.dev"

# Optional: Google Gemini API Key for AI features
GEMINI_API_KEY=""
